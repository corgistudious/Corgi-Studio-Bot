DISCORD_TOKEN=
CLIENT_ID=
MONGODB_URI=
DEV_GUILD_ID=
DEVELOPER_IDS=
# Optional AI. /ai works when this key is configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Bot account avatar is GLOBAL across every server using the same bot account.
# Set true only if that behavior is intended.
ALLOW_GLOBAL_AVATAR_BRANDING=false

# Corgi website shared API
WEB_API_ENABLED=false
WEB_API_PORT=3001
WEB_ALLOWED_ORIGINS=https://YOUR-WEBSITE.example
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Server-only. Never expose this in Vite/client env.
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
GLOBAL_REVIEW_LOG_CHANNEL_ID=YOUR_PRIVATE_GLOBAL_REVIEW_LOG_CHANNEL_ID
